# Generic Python project ignore rules.

# Byte-compiled and cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE and editor config
.idea/
.vscode/
*.swp
*.swo

# Build and packaging output
build/
dist/
*.spec
*.zip
*.tar.gz
*.exe
*.msi
*.dmg

# Coverage
.coverage
.coverage.*
htmlcov/

# Logs
*.log

# Per-user runtime data (now stored in the OS app-data directory)
custom_symbols.json

# OS junk
.DS_Store
Thumbs.db
desktop.ini
